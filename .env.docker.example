# Docker Compose settings. Copy this file to .env before deployment.
TZ=Asia/Shanghai
MPAY_PORT=8787
APP_DEBUG=false
MPAY_IMAGE=mpay-local:latest
# Optional Composer mirror for slow international networks, e.g. a trusted Packagist mirror.
COMPOSER_REPO=

# MySQL (not exposed to the public network)
MYSQL_DATABASE=mpay
MYSQL_USER=mpay
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Redis (not exposed to the public network)
REDIS_PASSWORD=replace-with-a-long-random-password

# Built-in Alipay bill watcher polling interval
ALIPAY_BILL_WATCHER_POLL_INTERVAL_SECONDS=0.5
